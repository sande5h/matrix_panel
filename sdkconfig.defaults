CONFIG_IDF_TARGET="esp32s3"

# The refresh buffer lives in internal DMA RAM; give the app room to breathe.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# ESP32-S3-N16R8: 16 MB flash, 8 MB octal PSRAM. The refresh buffer is always
# internal RAM, so PSRAM is left off -- enable it as octal (not quad) if the
# app needs it.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Custom table: two app slots for OTA plus the video partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Roll back to the previous slot if a freshly OTA'd image cannot get as far as
# starting its HTTP server -- see esp_ota_mark_app_valid_cancel_rollback() in
# app_main. Without this a bad push means walking over with a USB cable.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
